# Copy to .env and replace every placeholder locally. Never commit .env.
POSTGRES_USER=<choose-local-user>
POSTGRES_PASSWORD=<generate-a-local-password>
POSTGRES_DB=<choose-local-database>
JWT_SIGNING_KEY=<generate-at-least-32-random-characters>
ADMIN_REPLAY_KEY=<generate-a-separate-random-admin-key>
